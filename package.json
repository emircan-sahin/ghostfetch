{
  "name": "@emircansahin/ghostfetch",
  "version": "0.5.3",
  "description": "Resilient HTTP client for Node.js with TLS fingerprinting (CycleTLS/JA3), proxy rotation and health checks, sticky sessions with a cookie jar, and per-site retry rules that tell a bad proxy apart from a slow server",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "docs/API.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && echo '{\"type\":\"module\"}' > dist/esm/package.json && tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include=src/**",
    "test:ci": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "keywords": [
    "http-client",
    "fetch",
    "web-scraping",
    "scraping",
    "crawler",
    "proxy",
    "proxy-rotation",
    "rotating-proxy",
    "residential-proxy",
    "tls-fingerprint",
    "ja3",
    "ja4",
    "http2-fingerprint",
    "cycletls",
    "anti-bot",
    "bot-detection",
    "cloudflare",
    "bypass",
    "retry",
    "cookie-jar",
    "session",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emircan-sahin/ghostfetch.git"
  },
  "homepage": "https://github.com/emircan-sahin/ghostfetch#readme",
  "bugs": {
    "url": "https://github.com/emircan-sahin/ghostfetch/issues"
  },
  "author": "Emircan Sahin",
  "license": "MIT",
  "dependencies": {
    "cycletls": "^2.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
